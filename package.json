{
  "type": "module",
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "scripts": {
    "update-data": "node update.js --languages en,pl",
    "group-data": "node group.js --languages en,pl",
    "update-data-force": "node update.js --force --languages en,pl",
    "group-data-force": "node group.js --force --languages en,pl",
    "generate-docs": "node scripts/generate-docs.js",
    "diff-json": "node scripts/diff-json.js",
    "format": "prettier --write \"**/*.js\" --ignore-path .gitignore"
  }
}
